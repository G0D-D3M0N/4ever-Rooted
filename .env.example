# ─────────────────────────────────────────────────────────────
# 4ever Rooted — Environment Variables
# Add each of these to Replit Secrets (not this file).
# This file is for documentation only — no real values here.
# ─────────────────────────────────────────────────────────────

# ── Turso Database (required) ─────────────────────────────────
# Get from: https://turso.tech → your database → Connect
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Clerk Authentication (required) ───────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Admin Access ──────────────────────────────────────────────
# Comma-separated Clerk user IDs that have admin panel access
CLERK_ADMIN_USER_IDS=user_abc123,user_xyz456

# ── Session (optional, legacy) ────────────────────────────────
SESSION_SECRET=your-random-secret-string
